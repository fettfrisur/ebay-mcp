  "preserved_initial_commit": "2309c18f61ca33c421c2c763d709883a53c8f2c7",
  "timestamp_meaning": "Cloudflare version creation timestamps, not original Git commit dates. Historical author dates are truncated to whole seconds by Git; full precision is retained here. Committer dates are actual reconstruction times.",
  "bindings_policy": "Only names and types were exported; no binding values.",
  "code_commits": [
    {
      "cloudflare_number": 1,
      "commit": "2174a3dda71eefb5faf7b216a9e9ef2ce35ccdc1",
      "title": "initial eBay Browse worker (1.0.0)",
      "description": "Initial app-only eBay OAuth, German listing search and item details, JSON tool output, and an access key in the MCP URL path."
    },
    {
      "cloudflare_number": 7,
      "commit": "8efc033dc3f228febd47158174a910d9cbaf273a",
      "title": "Claude authentication and listing images (1.1.0)",
      "description": "Add header/Bearer authentication, the Anthropic egress allowlist, image URLs, and MCP read-only annotations while retaining the URL-key route."
    },
    {
      "cloudflare_number": 9,
      "commit": "c77f15ff73f5f39e5cc1fcc1ab3e5d7a3d9da9d1",
      "title": "condition filters and header-only access (1.2.0)",
      "description": "Remove URL-key access and distinguish working used, refurbished, and for-parts listings with explicit eBay condition IDs."
    },
    {
      "cloudflare_number": 10,
      "commit": "a21cfd1a5d8c54ac24cf3ce808c23d06e58e528a",
      "title": "scoped tokens and temporary feedback investigation",
      "description": "Keep OAuth tokens per scope and add a temporary read-only debug passthrough to investigate eBay Browse and Feedback responses. The server still identifies itself as 1.2.0."
    },
    {
      "cloudflare_number": 11,
      "commit": "b6a8fb1e69cd9db8777cc530fd7c6f9db1a7cde1",
      "title": "plain-text results and seller reputation (2.0.0)",
      "description": "Replace JSON results with readable text, inline seller reputation, add the seller-feedback tool and explicit failure reasons, and remove the temporary debug passthrough."
    },
    {
      "cloudflare_number": 12,
      "commit": "b107d9050b87e5d39cedda5a926f56c31314b8fd",
      "title": "seller-role feedback correction (2.0.1)",
      "description": "Change Feedback API filters from role:BUYER to role:SELLER because the role denotes the rated user. This recovers the corrected seller-feedback behavior."
    },
    {
      "cloudflare_number": 13,
      "commit": "8d5dee3eb7214bf7fc7c1924ec4c7d6f981c01b2",
      "title": "ChatGPT URL authentication (2.0.3)",
      "description": "Restore URL-key authentication for ChatGPT with OpenAI connector IP checks while preserving the Claude header route. Cloudflare version 14 later uploaded identical source."
    }
  ],
